# Copy to .env to change where media comes from.
# Default (no .env): recordings stream from alma.inc; posters load from public/media/demos/ (run `npm run media`).
# Everything local (after `npm run media -- --full`):
# PUBLIC_ASSET_BASE=""
# Waitlist: mock by default; "live" posts to Alma's POST /waitlist (same origin only).
# PUBLIC_WAITLIST_MODE=mock
