---
// The theatre: Alma's unedited recordings as evidence, not page art. A Mac in the deep plays the recording on its
// screen [USER, 01-PLAN §10]: the frame uncropped at its real 16:10, its real figures above it, the browser's own player
// controls (keyboard, captions, full screen). The water behind goes to the deep; the creature lights the Mac.
// Nothing is loaded from the recordings until it opens. [03-DESIGN-LANGUAGE §11; 05-CONVERSION C6, C7]
import Icon from "./Icon.astro";
import { DEMOS, type Demo } from "../data/demos";

// Passwords first, then the side-by-side against ChatGPT ("the most direct proof"), then the rest.
const ORDER: Demo["slug"][] = ["passwords", "krunker", "blender", "paint", "zerodha", "tinder"];
const list = ORDER.map((s) => DEMOS.find((d) => d.slug === s)!);
---
<dialog class="theatre" data-theatre aria-labelledby="theatre-title">
  <div class="th-bar">
    <div class="th-head">
      <h2 class="th-title" id="theatre-title" data-th-title></h2>
      <p class="th-figs" data-th-figs></p>
    </div>
    <button class="icon-btn th-close" type="button" data-th-close aria-label="Close recording"><Icon name="x" /></button>
  </div>

  <div class="th-frame">
    <div class="mac">
      <div class="mac-lid">
        <div class="mac-screen">
          <video class="th-video" data-th-video controls playsinline preload="none" width="1600" height="1000"></video>
          <p class="th-error" data-th-error hidden>This recording didn’t load. <a data-th-x target="_blank" rel="noopener" hidden>Watch the original post on X</a></p>
        </div>
      </div>
      <div class="mac-base" aria-hidden="true"></div>
    </div>
  </div>

  <div class="th-foot">
    <div class="th-list" role="group" aria-label="Unedited recordings">
      {list.map((d) => (
        <button class="th-item" type="button" data-th-pick={d.slug} aria-pressed="false">{d.tab}</button>
      ))}
    </div>
    <a class="btn btn-primary th-cta" href="#join" data-focus-join>Get early access</a>
  </div>
</dialog>

<style>
  .theatre {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(var(--s-4), env(safe-area-inset-top)) max(clamp(var(--s-4), 4vw, var(--s-8)), env(safe-area-inset-right)) max(var(--s-4), env(safe-area-inset-bottom)) max(clamp(var(--s-4), 4vw, var(--s-8)), env(safe-area-inset-left));
    border: 0;
    background: transparent;   /* the deep shows through: the scene goes dark behind the Mac */
    color: var(--ink-100);
    overscroll-behavior: contain;
  }
  .theatre[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: var(--s-4); }
  .theatre::backdrop { background: oklch(8% 0.03 300 / 0.55); }

  .th-bar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-4); }
  .th-head { min-width: 0; }
  .th-title { font-size: var(--t-h3); line-height: 1.3; letter-spacing: -0.01em; }
  .th-figs { font-size: var(--t-micro); line-height: 1.5; color: var(--ink-400); }
  .th-close { background: none; }

  /* The Mac: lid (bezel round a 16:10 screen) over a thin aluminium base. Sized so the whole machine fits the space;
     the recording is never cropped. Material colours: 04-DESIGN-SYSTEM §10 (Mac). */
  .th-frame { container-type: size; display: grid; place-items: center; min-height: 0; }
  .mac { --w: min(92cqw, 138cqh); width: var(--w); display: grid; justify-items: center; }
  .mac-lid {
    width: 100%;
    padding: calc(var(--w) * 0.022) calc(var(--w) * 0.022) calc(var(--w) * 0.03);
    border-radius: var(--r-surface) var(--r-surface) 0 0;
    background: oklch(11% 0.008 300);
    /* the aluminium edge, and the creature's violet light catching its top */
    box-shadow:
      inset 0 0 0 1.5px oklch(46% 0.012 295),
      inset 0 1.5px 0 0 oklch(72% 0.09 290 / 0.8),
      0 -24px 90px -50px var(--life);
  }
  .mac-screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--r-pill); background: #000; display: grid; place-items: center; }
  .th-video { width: 100%; height: 100%; object-fit: contain; background: #000; }
  .mac-base {
    width: 112%;
    height: calc(var(--w) * 0.028);
    border-radius: 0 0 var(--r-surface) var(--r-surface);
    background: linear-gradient(to bottom, oklch(70% 0.03 292) 0, oklch(46% 0.015 295) 22%, oklch(30% 0.012 300) 100%);
    clip-path: polygon(0 0, 100% 0, 99% 100%, 1% 100%);
    position: relative;
  }
  /* the thumb notch on the front edge */
  .mac-base::before { content: ""; position: absolute; left: 50%; top: 0; width: 13%; height: 34%; transform: translateX(-50%); border-radius: 0 0 var(--r-pill) var(--r-pill); background: oklch(36% 0.012 298); }
  .th-error { padding: var(--s-5); font-size: var(--t-input); color: var(--ink-300); text-align: center; }
  .th-error[hidden], .th-error [hidden] { display: none; }
  .th-frame:has(.th-error:not([hidden])) .th-video { display: none; }

  .th-foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-5); }
  .th-list { display: flex; gap: var(--s-5); min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .th-list::-webkit-scrollbar { display: none; }
  .th-item {
    flex: none;
    min-height: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-400);
    font-size: var(--t-input);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    cursor: pointer;
    transition: color var(--d-hover) ease, text-decoration-color var(--d-hover) ease;
  }
  .th-item[aria-pressed="true"] { color: var(--ink-100); text-decoration-color: var(--ink-100); }
  @media (hover: hover) and (pointer: fine) { .th-item:hover { color: var(--ink-100); } }
  .th-cta { height: 52px; }

  @media (max-width: 767px) {
    .th-foot { grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
    .th-list { gap: var(--s-4); margin-inline: calc(-1 * var(--s-4)); padding-inline: var(--s-4); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .theatre[open] { animation: theatre-in var(--d-enter) var(--ease-out); }
    @keyframes theatre-in { from { opacity: 0; transform: scale(0.98); } }
  }
</style>
