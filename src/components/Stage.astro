---
// The Dive (docs/dive). One pinned screen: the water is the page, the jellyfish is the image, the type sits in it.
// This is the Surface: a complete page by itself (headline, mechanism line, email, proof link). [05-CONVERSION C2]
//
// Layers [04-DESIGN-SYSTEM §7]: scene canvas < copy, wordmark < dock < dialogs.
// .dive is the scroll track; it is one screen tall until the descent is built, then it lengthens and .stage stays pinned.
import Icon from "./Icon.astro";
import WaitlistForm from "./WaitlistForm.astro";
import Sheets from "./Sheets.astro";
import Theatre from "./Theatre.astro";
import { DEFAULT_DEMO, demoFiles, type Demo } from "../data/demos";
import { CHORES } from "../data/chores";

interface Props {
  /** /demos/<slug>/ opens that recording in the theatre over the Surface */
  initialDemo?: Demo;
}
const { initialDemo } = Astro.props;
---
<canvas class="scene" data-creature-canvas aria-hidden="true"></canvas>

<div class="dive" data-dive>
  <div class="stage" data-stage data-initial={initialDemo?.slug}>
    <header class="top">
      <a class="wordmark" href="/" aria-label="Alma home">Alma</a>
    </header>

    <!-- The progress signal that replaces the scrollbar: a hairline and a tiny jellyfish that travels down it. The three
         depths are real buttons (named for screen readers, never on screen) that scroll there. -->
    <nav class="depth" aria-label="Depth" data-depthline>
      <ol class="depth-marks">
        <li><button class="depth-mark" type="button" data-goto="surface" aria-current="step"><span class="depth-label">Surface</span></button></li>
        <li><button class="depth-mark" type="button" data-goto="mid"><span class="depth-label">Mid-water</span></button></li>
        <li><button class="depth-mark" type="button" data-goto="deep"><span class="depth-label">The deep</span></button></li>
      </ol>
      <!-- where you are: a tiny jellyfish on the line. Before the first scroll it strokes and sinks a little (the way
           down, without a word); at the end it folds to a bud and blooms with the creature. -->
      <span class="depth-dot" data-depth-dot aria-hidden="true">
        <svg class="glyph" viewBox="0 0 16 20" width="12" height="15">
          <path class="g-bell" d="M1.5 9C1.5 4.6 4.4 1.5 8 1.5s6.5 3.1 6.5 7.5c-1.8.9-4 1.3-6.5 1.3S3.3 9.9 1.5 9z" />
          <path class="g-tent" d="M4.6 10.4c-.3 2.6.4 4.8-.4 7M8 10.7v7.8M11.4 10.4c.3 2.6-.4 4.8.4 7" />
        </svg>
      </span>
    </nav>

    <div class="slot" data-creature-slot aria-hidden="true"></div>

    <main class="rests" id="main">
    <!-- The three rests share one place in the grid; scrolling picks which is current. Without JavaScript only the
         Surface shows (step 5 owes the readable three-section fallback). [01-PLAN §2] -->
    <div class="copy rest" data-copy data-rest="surface" data-current>
      <h1 class="headline" data-headline>
        <span class="line"><span class="line-in">Never do</span></span>
        <span class="line"><span class="line-in">it again.</span></span>
      </h1>
      <p class="sub" data-sub>Alma operates your Mac for you. Any app, while you watch.</p>
      <!-- without JavaScript this is a plain link to the recording itself -->
      <a class="watch" href={demoFiles(initialDemo?.slug ?? DEFAULT_DEMO).src} data-watch><Icon name="play" />Watch it work</a>

    </div>

    <!-- Mid-water: how it works, and the proof link again [05-CONVERSION §4, C2/priority 3] -->
    <section class="rest rest-mid" data-rest="mid" aria-labelledby="mid-title" inert>
      <h2 class="title" id="mid-title">Any app you already use.</h2>
      <p class="lead">You see every step, and you can stop it any time.</p>
      <a class="watch" href={demoFiles(initialDemo?.slug ?? DEFAULT_DEMO).src} data-watch><Icon name="play" />Watch it work</a>
    </section>

    <!-- The deep: who is behind it. Nothing unconfirmed (no angels' names) [05-CONVERSION §4, O4] -->
    <section class="rest rest-deep" data-rest="deep" aria-labelledby="deep-title" inert>
      <h2 class="title" id="deep-title">Built by Sarvam AI’s founding engineers.</h2>
      <p class="lead">Ex&#8209;Microsoft Research. Backed by Peak XV.</p>
      <!-- the keyboard way to what the Macs show (each Mac also opens its own recording) -->
      <a class="watch" href={demoFiles(initialDemo?.slug ?? DEFAULT_DEMO).src} data-watch><Icon name="play" />Watch it work</a>
    </section>

    </main>

    <div class="dock" data-dock>
      <WaitlistForm />
      <!-- after joining: hand Alma the first chore. In the dock, so it works at any depth [01-PLAN §10] -->
      <div class="chores" role="group" aria-labelledby="chores-label" data-chores>
        <p id="chores-label" class="chores-lead">Hand it the first one:</p>
        {CHORES.map((c) => <button class="chore" type="button" data-chore-pick>{c}</button>)}
        <button class="chore" type="button" data-name-own>Name your own</button>
      </div>
      <form class="handover" data-handover hidden>
        <label for="handover-input" class="sr-only">Name a chore you’re done with</label>
        <input id="handover-input" class="handover-input" type="text" name="chore" maxlength="200" autocomplete="off" enterkeyhint="done" placeholder="Name a chore you’re done with" />
        <button class="handover-go" type="submit" aria-label="Hand it over"><Icon name="arrowRight" /></button>
      </form>
    </div>
  </div>
</div>

<Theatre />
<Sheets />

<script>
  import "../scripts/main";
</script>

<style is:global>
  /* One screen until the descent exists; the scene owns the whole viewport. */
  html, body { overscroll-behavior: none; }
  /* No scrollbar [USER]: the depth line is the progress signal. Scrolling itself is untouched. */
  html { scrollbar-width: none; }
  html::-webkit-scrollbar { display: none; }
  /* Browser surfaces, from the palette: violet is the creature's life (focus, selection, caret) */
  ::selection { background: var(--life); color: var(--on-glow); }
  input, textarea { caret-color: var(--life); }
  :root { accent-color: var(--life); }

  .scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }
  .creature-ready .scene { opacity: 1; }
  .creature-fallback .scene { display: none; }
  .creature-ready .grain { display: none; }

  /* Before the scene loads, without WebGL, with save-data or without JavaScript: the same water as a still.
     Light from above on the right, falling to plum-black where the type sits. */
  body {
    background:
      radial-gradient(70% 62% at 68% -8%, oklch(52% 0.11 262 / 0.5), transparent 70%),
      linear-gradient(to bottom, var(--water-surface-top), var(--water-surface-bottom) 62%, var(--sea-900));
    background-attachment: fixed;
  }
</style>

<style>
  .dive { position: relative; }
  /* the track: one screen per rest. vh, not dvh: the URL bar showing or hiding must not re-layout it [JURY 19] */
  :global(.js) .dive { height: 300vh; }
  .stage {
    --pad-x: max(clamp(var(--s-5), 4vw, var(--s-8)), env(safe-area-inset-left), env(safe-area-inset-right));
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: 100dvh;
    padding: max(var(--s-5), env(safe-area-inset-top)) var(--pad-x) max(var(--s-5), env(safe-area-inset-bottom));
  }
  .top, .copy, .dock { position: relative; z-index: 1; }

  .top { display: flex; align-items: center; height: var(--tap-min); }
  .wordmark { display: inline-flex; align-items: center; min-height: var(--tap-min); font-size: 1.375rem; font-weight: 500; letter-spacing: -0.02em; text-decoration: none; }

  /* The creature's region. It is the only thing that ignores the grid; nothing else enters this region. */
  .slot { pointer-events: none; min-height: 0; }

  /* ---------- the promise ---------- */
  .copy { display: grid; justify-items: start; gap: var(--s-4); min-width: 0; }
  .headline {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    font-weight: 500;
    margin-left: -0.04em; /* optical: the N's stem sits on the gutter, not its sidebearing */
  }
  .headline[data-long] { font-size: var(--t-display-long); line-height: 1; letter-spacing: -0.03em; margin-left: 0; }
  .headline :global(.line) { display: block; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .headline :global(.line-in) { display: block; }
  .rests { display: contents; }
  .rest { grid-row: 2; min-width: 0; }
  /* one column: items that share a row overlap instead of spilling into new implicit columns */
  .top, .slot, .rest, .dock { grid-column: 1; }
  /* Below the Surface each depth has three levels: Title, one Lead line, then the link. [01-PLAN §10; JURY 03] */
  .rest-mid, .rest-deep { display: grid; justify-items: start; align-content: end; gap: var(--s-4); }
  .title { max-width: 15ch; font-size: var(--t-title); line-height: var(--lh-title); letter-spacing: var(--track-title); font-weight: 500; text-wrap: balance; }
  .lead { max-width: 34ch; color: var(--ink-300); font-size: var(--t-lead); line-height: 1.45; letter-spacing: -0.01em; text-wrap: pretty; }
  .rest-mid .watch { margin-top: var(--s-2); }
  /* only the current rest is on screen; the others leave as a group, faster than they arrive [EMIL] */
  /* Without the scrubbed dive (reduced motion, very short screens) the rests crossfade, 200ms, no travel [04 §6] */
  :global(html.js:not(.dive-motion)) .rest { transition: opacity 200ms ease, visibility 0s linear 200ms; }
  :global(html.js:not(.dive-motion)) .rest:not([data-current]) { opacity: 0; visibility: hidden; }
  :global(html.js:not(.dive-motion)) .rest[data-current] { transition: opacity 200ms ease, visibility 0s; }
  /* A long trip (depth line, "Back to the surface"): the depths passed on the way stay hidden, no text flickers by */
  :global(html.dive-travel) .rest:not([data-travel-target]) { opacity: 0 !important; transition: opacity var(--d-enter) ease; }
  /* With it, GSAP owns their opacity and position (dive.ts); this only covers the first paint */
  :global(html.js.dive-motion) .rest:not([data-current]) { visibility: hidden; }
  .sub { max-width: 34ch; color: var(--ink-300); font-size: var(--t-lead); line-height: 1.45; letter-spacing: -0.01em; }

  /* the proof link: text, not a second button */
  .watch {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap-min);
    color: var(--ink-100);
    font-size: var(--t-input);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color var(--d-hover) ease, transform var(--d-press) var(--ease-out);
  }
  .watch :global(svg) { width: 12px; height: 12px; flex: none; }
  .watch:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .watch:hover { text-decoration-color: var(--ink-100); } }

  /* ---------- after joining: hand it the first chore ---------- */
  .chores { display: none; flex-wrap: wrap; align-items: baseline; column-gap: var(--s-5); row-gap: 0; max-width: 480px; }
  :global(html[data-beat="joined"]) .chores { display: flex; }
  .chores-lead { width: 100%; margin: 0; font-size: var(--t-micro); color: var(--ink-400); }
  .chore {
    min-height: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-300);
    font-size: var(--t-input);
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    cursor: pointer;
    transition: color var(--d-hover) ease, text-decoration-color var(--d-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) { .chore:hover { color: var(--ink-100); text-decoration-color: var(--ink-100); } }
  .chore:focus-visible { color: var(--ink-100); }
  .chore[data-gone], .chore[hidden] { display: none; }

  .handover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: 100%;
    max-width: 480px;
    padding-left: var(--s-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--sea-800);
    transition: border-color var(--d-hover) ease, box-shadow var(--d-hover) var(--ease-out);
  }
  .handover[hidden] { display: none; }
  .handover:focus-within { border-color: var(--life); box-shadow: 0 0 0 3px var(--glow-halo); }
  .handover-input { min-width: 0; height: var(--tap-min); padding: 0; border: 0; background: none; color: var(--ink-100); font-size: var(--t-input); }
  .handover-input::placeholder { color: var(--ink-400); }
  .handover-input:focus { outline: none; }
  .handover-go {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--ink-300);
    cursor: pointer;
    transition: color var(--d-hover) ease, transform var(--d-press) var(--ease-out);
  }
  .handover-go :global(svg) { width: 18px; height: 18px; }
  .handover-go:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .handover-go:hover { color: var(--ink-100); } }

  /* ---------- the dock: its own surface, so its contrast never depends on the water. It never moves. ---------- */
  .dock { grid-row: 3; width: 100%; max-width: 480px; }
  .dock :global(.wl) { max-width: none; }
  .dock :global(.wl-label) { font-size: var(--t-micro); color: var(--ink-300); }
  .dock :global(.wl-msg) { font-size: var(--t-micro); }
  .dock :global(.wl-row) { grid-template-columns: minmax(0, 1fr) auto; }
  @media (max-width: 359px) { .dock :global(.wl-row) { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- the depth line: replaces the scrollbar; right edge, vertically centred ----------
     Round 4 [USER: "need not be that eyesore", "not saying it aloud"]: one faint hairline, no ticks, no words. The
     marks stay as real buttons (screen readers and keyboards get their names; focus shows a ring). */
  .depth { position: absolute; z-index: 1; top: 50%; right: calc(var(--pad-x) - var(--s-3)); transform: translateY(-50%); }
  :global(html:not(.js)) .depth { display: none; }
  .depth-marks { position: relative; display: grid; list-style: none; margin: 0; padding: 0; }
  .depth-marks::before { content: ""; position: absolute; top: 22px; bottom: 22px; right: 21.5px; width: 1px; background: var(--line); }
  .depth-mark { display: block; width: var(--tap-min); height: var(--tap-min); padding: 0; border: 0; background: none; cursor: pointer; }
  .depth-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* the jellyfish: travels with the dive (smoothed value) */
  .depth-dot { position: absolute; top: 14.5px; right: 16px; width: 12px; height: 15px; pointer-events: none; }
  .glyph { display: block; overflow: visible; }
  .g-bell { fill: var(--ink-100); transform-box: fill-box; transform-origin: 50% 100%; }
  .g-tent { fill: none; stroke: var(--ink-300); stroke-width: 1.1; stroke-linecap: round; transform-box: fill-box; transform-origin: 50% 0; }
  @media (prefers-reduced-motion: no-preference) {
    /* until the first scroll: one slow stroke and a short sink, then it drifts back up. Ambient, 3.2s. */
    :global(html:not([data-dived])) .glyph { animation: sink 3.2s cubic-bezier(0.4, 0, 0.2, 1) 1s infinite; }
    :global(html:not([data-dived])) .g-bell { animation: stroke 3.2s cubic-bezier(0.4, 0, 0.2, 1) 1s infinite; }
    @keyframes sink { 0%, 100% { transform: translateY(0); opacity: 1; } 45% { transform: translateY(12px); opacity: 0.55; } }
    @keyframes stroke { 0%, 30%, 100% { transform: scale(1, 1); } 12% { transform: scale(0.82, 1.08); } }
    /* at The deep, after a moment: it folds to a bud, holds, and blooms again, with the creature (1.4s, 0.6s, 1.4s) */
    :global(html[data-cycle]) .g-bell { animation: fold-bell 3.4s cubic-bezier(0.77, 0, 0.175, 1) both; }
    :global(html[data-cycle]) .g-tent { animation: fold-tent 3.4s cubic-bezier(0.77, 0, 0.175, 1) both; }
    /* going home from The deep: folded for the climb, blooming on arrival */
    .g-bell, .g-tent { transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1), opacity 1.2s ease; }
    :global(html[data-folded]) .g-bell { transform: scale(0.42, 0.62); }
    :global(html[data-folded]) .g-tent { transform: scaleY(0.18); opacity: 0.5; }
    @keyframes fold-bell { 0%, 100% { transform: scale(1, 1); } 41%, 59% { transform: scale(0.42, 0.62); } }
    @keyframes fold-tent { 0%, 100% { transform: scaleY(1); opacity: 1; } 41%, 59% { transform: scaleY(0.18); opacity: 0.5; } }
  }

  /* a recording is playing on the Mac: the page steps aside, only the water stays behind it */
  .stage { transition: opacity var(--d-enter) var(--ease-out); }
  :global(html[data-theatre]) .stage { opacity: 0; visibility: hidden; transition: opacity var(--d-exit) ease, visibility 0s linear var(--d-exit); }

  /* the form grows a little with depth, in place: the deeper you are, the more it is the point [USER, 01-PLAN §10] */
  .dock { --field-h: 52px; transition: max-width var(--d-reveal) var(--ease-out); }
  .dock :global(.wl-input), .dock :global(.wl-submit) { height: var(--field-h); transition: height var(--d-reveal) var(--ease-out), border-color var(--d-hover) ease, box-shadow var(--d-hover) var(--ease-out); }
  :global(html:not(.dive-motion)[data-depth="mid"]) .dock { --field-h: 48px; max-width: 400px; }
  :global(html:not(.dive-motion)[data-depth="deep"]) .dock { --field-h: 56px; max-width: 520px; }
  :global(html[data-depth="deep"]) .dock :global(.wl-submit) { padding-inline: var(--s-6); }

  /* ---------- desktop: type low on a strong left edge; the creature right of centre, high ---------- */
  @media (min-width: 1024px) {
    .stage { grid-template-rows: auto minmax(0, 1fr) auto; }
    .slot { position: absolute; inset: 0; }
    .copy { align-self: end; max-width: min(41.667%, 560px); } /* at most 5 of 12 columns */
    /* Mid-water: the creature moves left, so the line goes right, on the dock's baseline. [03 §6] */
    /* Mid-water: compact, on the left edge above a smaller form; the creature takes the right [USER, round 3] */
    .rest-mid { align-self: end; justify-self: start; width: min(36%, 440px); gap: var(--s-3); }
    .rest-mid .title { font-size: clamp(2rem, 0.8rem + 2.4vw, 3.25rem); }
    /* The deep: the creature small and centred, the line centred beneath it, above the dock */
    .rest-deep { align-self: end; justify-self: center; justify-items: center; text-align: center; margin-bottom: var(--s-6); }
    .rest-deep .title { max-width: 18ch; }
    @media (max-height: 760px) { .rest-deep { margin-bottom: var(--s-4); gap: var(--s-3); } }
    /* The deep: the form comes to the middle, under the title [USER, round 3] */
    :global(html:not(.dive-motion)[data-depth="deep"]) .dock { justify-self: center; }
    :global(html[data-depth="deep"]) .dock :global(.wl-label), :global(html[data-depth="deep"]) .dock :global(.wl-platform),
    :global(html[data-depth="deep"]) .dock :global(.wl-msg), :global(html[data-depth="deep"]) .dock :global(.wl-done) { text-align: center; }
    :global(html[data-depth="deep"]) .dock :global(.wl-done), :global(html[data-depth="deep"]) .chores { justify-content: center; }
    :global(html[data-depth="deep"]) .chores-lead { text-align: center; }
    .dock { margin-top: clamp(var(--s-5), 6dvh, var(--s-7)); }
  }

  /* ---------- phones and tablets: the creature above, the promise under it, the dock at the foot ---------- */
  @media (max-width: 1023px) {
    .stage { grid-template-rows: auto minmax(0, 1fr) auto auto; row-gap: var(--s-4); }
    .slot { grid-row: 2; }
    .rest { grid-row: 3; align-self: end; }
    .dock { grid-row: 4; }
    .depth { top: 22%; right: max(0px, calc(env(safe-area-inset-right) - var(--s-3))); }
    .top { height: 36px; }
    .copy { gap: var(--s-3); }
    .chores { column-gap: var(--s-4); }
  }
  /* short screens keep one screen: the smallest lines give way first, never the field */
  @media (max-height: 620px) {
    .dock :global(.wl-label) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 1023px) and (max-height: 700px) {
    .sub { font-size: var(--t-input); }
    .dock :global(.wl-platform) { display: none; }
  }
  /* Without JavaScript: a plain readable page in reading order: the promise, the form, how it works, who builds it.
     The form posts natively; "Watch it work" links to the recording file. [05 C12; 02 §2 principle 10] */
  :global(html:not(.js)) .stage { position: relative; display: flex; flex-direction: column; gap: var(--s-8); height: auto; min-height: 100dvh; padding-bottom: var(--s-9); }
  :global(html:not(.js)) .slot { display: none; }
  :global(html:not(.js)) .top { order: 0; }
  :global(html:not(.js)) .copy { order: 1; }
  :global(html:not(.js)) .dock { order: 2; margin-top: 0; }
  :global(html:not(.js)) .rest-mid { order: 3; }
  :global(html:not(.js)) .rest-deep { order: 4; text-align: left; justify-items: start; margin-bottom: 0; }
  :global(html:not(.js)) .rest { align-self: stretch; width: auto; max-width: 560px; padding-right: 0; }

  /* With JavaScript but without WebGL (or with save-data): the water still changes by depth, as stills */
  :global(html.creature-fallback) body::before, :global(html.creature-fallback) body::after {
    content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity 600ms var(--ease-out);
  }
  :global(html.creature-fallback) body::before { background: linear-gradient(to bottom, var(--water-mid-top), var(--water-mid-bottom)); }
  :global(html.creature-fallback) body::after { background: radial-gradient(40% 36% at 50% 22%, oklch(42% 0.14 290 / 0.35), transparent 70%), linear-gradient(to bottom, var(--sea-900), var(--sea-950)); }
  :global(html.creature-fallback[data-depth="mid"]) body::before { opacity: 1; }
  :global(html.creature-fallback[data-depth="deep"]) body::after { opacity: 1; }

  @media (max-height: 440px) {
    .stage { position: relative; height: auto; min-height: 100dvh; }
    :global(.js) .dive { height: auto; }   /* too short to pin: the Surface stands alone */
  }

  /* Entrance: the type rises through its masks as the light comes up. It never delays the field. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .headline :global(.line-in) { animation: rise 900ms var(--ease-out) both; }
    :global(.js) .headline :global(.line:nth-child(2) .line-in) { animation-delay: var(--stagger); }
